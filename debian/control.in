Source: linux
Section: kernel
Maintainer: Maria Lisina <sekoohaka.sarisan@gmail.com>
Build-Depends: debhelper-compat (= 13),
               bc,
               bison,
               flex,
               kmod,
               pahole,
               python3,
               rsync,
               zstd,
               libelf-dev,
               libssl-dev,
               clang-@LLVM@,
               lld-@LLVM@,
               llvm-@LLVM@
Standards-Version: 4.7.4

Package: linux-image-@NAME@
Architecture: amd64
Depends: linux-image-@KERNELRELEASE@ (= ${binary:Version}),
         ${misc:Depends}
Description: Linux Kernel for Intel laptops

Package: linux-image-@KERNELRELEASE@
Architecture: amd64
Depends: dracut,
         linux-base,
         zstd,
         firmware-intel-graphics,
         firmware-iwlwifi,
         firmware-sof-signed,
         ${misc:Depends}
Recommends: apparmor
Suggests: linux-image-@NAME@-common (= ${binary:Version}),
          firmware-realtek
Description: Linux Kernel for Intel laptops

Package: linux-image-@NAME@-dbg
Section: debug
Architecture: amd64
Depends: linux-image-@KERNELRELEASE@-dbg (= ${binary:Version}),
         ${misc:Depends}
Description: Linux Kernel debug symbols for Intel laptops

Package: linux-image-@KERNELRELEASE@-dbg
Section: debug
Architecture: amd64
Depends: ${misc:Depends}
Description: Linux Kernel debug symbols for Intel laptops

Package: linux-headers-@NAME@
Architecture: amd64
Depends: linux-headers-@KERNELRELEASE@ (= ${binary:Version}),
         ${misc:Depends}
Description: Linux Kernel headers for Intel laptops

Package: linux-headers-@KERNELRELEASE@
Architecture: amd64
Depends: make,
         bc,
         kmod,
         zstd,
         libelf-dev,
         libssl-dev,
         clang-@LLVM@,
         lld-@LLVM@,
         llvm-@LLVM@,
         ${shlibs:Depends},
         ${misc:Depends}
Description: Linux Kernel headers for Intel laptops

Package: linux-image-@NAME@-common
Architecture: amd64
Depends: systemd,
         ${misc:Depends}
Description: Linux Kernel common files for Intel laptops

Package: linux-libc-dev
Section: devel
Architecture: amd64
Depends: ${misc:Depends}
Description: Linux Kernel headers for user-space development
