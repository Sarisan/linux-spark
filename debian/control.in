Source: linux
Section: kernel
Maintainer: Maria Lisina <sekoohaka.sarisan@gmail.com>
Build-Depends: debhelper-compat (= 13),
               bc,
               bison,
               flex,
               kmod,
               pahole,
               python3,
               rsync,
               libelf-dev,
               libssl-dev,
               clang-22,
               lld-22,
               llvm-22
Standards-Version: 4.7.4

Package: linux-image-@NAME@
Architecture: amd64
Depends: linux-image-@KERNELRELEASE@ (= ${binary:Version}),
         ${misc:Depends}
Description: Linux Kernel for Intel laptops

Package: linux-image-@KERNELRELEASE@
Architecture: amd64
Depends: dracut,
         linux-base,
         firmware-intel-graphics,
         firmware-iwlwifi,
         firmware-sof-signed,
         ${misc:Depends}
Recommends: apparmor
Suggests: linux-image-@NAME@-common (= ${binary:Version}),
          firmware-realtek
Description: Linux Kernel for Intel laptops

Package: linux-image-@NAME@-dbg
Section: debug
Architecture: amd64
Depends: linux-image-@KERNELRELEASE@-dbg (= ${binary:Version}),
         ${misc:Depends}
Description: Linux Kernel debug for Intel laptops

Package: linux-image-@KERNELRELEASE@-dbg
Section: debug
Architecture: amd64
Depends: ${misc:Depends}
Description: Linux Kernel debug for Intel laptops

Package: linux-image-@NAME@-common
Architecture: amd64
Depends: systemd,
         ${misc:Depends}
Description: Linux Kernel common files for Intel laptops
